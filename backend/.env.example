# ─── Database Configuration ──────────────────────────────────────────────
DATABASE_URL=postgresql://your_user:your_password@your_host:5432/your_db

# ─── Security ────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-this-to-a-strong-random-secret
JWT_ALGORITHM=HS256

# ─── AI Intelligence Engine (Phase 9) ───────────────────────────────────
# Groq — LLM Provider (https://console.groq.com)
GROQ_API_KEY=your_groq_api_key

# Tavily — Threat Intelligence Search (https://tavily.com)
TAVILY_API_KEY=your_tavily_api_key

# OCR Language
OCR_LANGUAGE=eng

# AI Configuration
AI_PROVIDER=groq                       # AI provider: groq
AI_MODEL=llama-3.3-70b-versatile       # LLM model to use
AI_TIMEOUT=30                           # Request timeout in seconds
AI_MAX_RETRIES=3                        # Max retry attempts on failure
AI_CACHE_TTL=3600                       # Cache TTL in seconds (1 hour)
AI_ENABLED=true                         # Enable/disable AI enrichment
AI_LOG_LEVEL=INFO                       # Logging level: DEBUG, INFO, WARNING, ERROR
